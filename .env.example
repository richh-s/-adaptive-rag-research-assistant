# Google AI Studio API key (free tier, no credit card required)
# Required always -- Gemini handles embeddings regardless of which chat provider is primary,
# and serves as the chat fallback when ANTHROPIC_API_KEY is set.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Web search: DuckDuckGo via the `ddgs` package (see retrieval/web_search.py). No API key,
# signup, or billing account required -- unlike Google Custom Search (which gates even its
# free tier behind a linked billing account) or Brave/Tavily (paid). Nothing to configure here.

# Anthropic API key. This line must exist (config validation fails fast if it's absent
# entirely), but the value itself may be left blank. When set, Claude becomes the primary
# chat/reasoning model for routing, decomposition, grading, and synthesis, with automatic
# fallback to Gemini on error. Left blank, Gemini is used for everything, as before.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# App environment: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Redis (caches router decisions, web search results, and synthesized answers -- see cache.py).
# Set USE_CACHE=false to disable outright (tests do this automatically).
REDIS_URL=redis://localhost:6379/0
USE_CACHE=true
CACHE_TTL_ROUTER=300
CACHE_TTL_WEB_SEARCH=600
CACHE_TTL_SYNTHESIS=1800

# Rate limiting (requests/minute)
RATE_LIMIT_RPM=10
RATE_LIMIT_RPM_GLOBAL=30

# Request timeouts (seconds)
WEB_SEARCH_TIMEOUT_SECONDS=10
GRAPH_TIMEOUT_SECONDS=45
# Per-attempt LLM timeout + retry cap. Keeps a slow/rate-limited provider from silently
# retrying with backoff for tens of seconds (Gemini defaults to 6 retries) and starving the
# rest of the graph's GRAPH_TIMEOUT_SECONDS budget.
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# Self-hosted models on an OpenAI-compatible /v1 endpoint (Ollama, vLLM, LM Studio,
# llama.cpp). Setting this promotes the local box to PRIMARY chat/reasoning provider, with
# Anthropic and Gemini as automatic fallbacks behind it -- every graph node runs at $0 while
# the endpoint is reachable, and a host with no route to it degrades to Claude instead of
# failing. Leave blank to disable.
#
# Use the MagicDNS name, not the raw 100.x tailnet IP: the IP is stable per node but the DNS
# name survives a node being removed and re-added. Get the real model list from a machine
# that is on the tailnet, rather than guessing:
#   curl http://<host>:11434/api/tags | jq -r '.models[].name'   # Ollama
#   curl http://<host>:8000/v1/models                            # vLLM
#
# The endpoint must be reachable from wherever the API RUNS, not just from your laptop. A
# Render/Fly/Vercel deploy is not on your tailnet: leave LOCAL_LLM_BASE_URL blank there.
# LOCAL_LLM_BASE_URL=http://edgexpert.your-tailnet.ts.net:11434/v1
# LOCAL_LLM_CHAT_MODEL=gemma-4-26b
# Only if something in front of the server enforces a key -- Ollama/vLLM don't by default.
# LOCAL_LLM_API_KEY=
# Long read timeout (local generation is slow), short connect timeout so an unreachable box
# fails over to Anthropic in ~2s instead of eating GRAPH_TIMEOUT_SECONDS.
# LOCAL_LLM_TIMEOUT_SECONDS=180
# LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=2
# Floor, not a cap on the answer: reasoning models spend the budget thinking first and
# return an empty content if it runs out.
# LOCAL_LLM_MAX_TOKENS=4096
# One retry absorbs the transient 500 single-model Ollama returns while swapping models.
# LOCAL_LLM_MAX_RETRIES=1
# How structured output is requested. json_schema = server-side constrained decoding
# (Ollama/vLLM); function_calling = servers with tool support but no guided decoding;
# json_mode = neither, at the cost of the model never seeing the schema.
# LOCAL_LLM_STRUCTURED_OUTPUT_METHOD=json_schema
#
# Note: embeddings always go to Gemini regardless. The Chroma index is built at one
# embedding dimension, and swapping providers under it returns nonsense neighbours instead
# of an error -- it would require `rag-assistant ingest --full`.

# Optional overrides — defaults shown
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Authentication (production). Comma-separated API keys; each entry is `label:key` (label
# becomes the tenant -- conversations and rate limits are scoped to it) or a bare `key`.
# Leave blank to run the API open (local development / public demo mode).
#   Example: API_KEYS=alice:sk-live-a1b2...,bob:sk-live-c3d4...
API_KEYS=

# Error tracking (production). Set a Sentry DSN to capture unhandled exceptions; blank = off.
SENTRY_DSN=

# PDF vision ingestion: describe charts/diagrams in PDFs and transcribe scanned pages using
# the chat provider's vision capability (one call per figure/scanned page at ingest time).
PDF_VISION=true

# Browser origins allowed to call this API cross-origin. Comma-separated. The defaults cover
# the Vite dev server; the single-container deploy (Docker/Render) serves the frontend from
# this same origin and needs none of them, so it can safely be blank there. Set it explicitly
# when the frontend is hosted separately -- e.g. the UI on Vercel and the API on Render.
#   Example: CORS_ALLOW_ORIGINS=https://myapp.vercel.app
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Fraction of requests sampled for Sentry performance tracing (0.0-1.0). Errors are always
# captured when SENTRY_DSN is set; this is only the latency-tracing sample rate. 0.0 is right
# for a low-traffic demo -- raise to ~0.1 once there is enough traffic for percentiles to mean
# something.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Prometheus metrics at GET /metrics. When API_KEYS is set the endpoint requires a key like
# any other protected route, so a scraper needs one too. Set false to remove the route.
# METRICS_ENABLED=true

# Conversation retention. Transcripts live on the same mounted volume as the Chroma index, so
# without a ceiling they grow forever. Two independent limits, each disabled by setting it
# to 0; pruning runs after each appended turn, scoped to the tenant that wrote.
# CONVERSATION_RETENTION_DAYS=90
# CONVERSATION_MAX_PER_OWNER=500

# Ceiling on how much retrieved context reaches the synthesis prompt. Fusion's output grows
# with (sub-queries x retrieval paths), not with the question, so without a cap prompt cost
# and latency scale with retrieval breadth and eventually overflow the model's context
# window. Documents arrive ranked, so the cap drops the ones already judged least useful.
# Set to 0 to disable (e.g. on a long-context model).
# SYNTHESIS_CONTEXT_BUDGET_TOKENS=6000
# Characters per token, used to estimate the budget above. An estimate on purpose: Anthropic,
# Gemini and self-hosted servers don't share a tokenizer, so an exact count for one is wrong
# for the others. Lower it to be more conservative on code or CJK text.
# SYNTHESIS_CHARS_PER_TOKEN=4.0

# ---------------------------------------------------------------------------
# Retrieval quality
# ---------------------------------------------------------------------------
# Chunking within a heading section. "structural" is fixed-size (free, deterministic);
# "semantic" embeds sentences and breaks at topic shifts, costing one embedding call per
# section at ingest time. Changing this re-indexes automatically (CHUNKING_VERSION).
# CHUNKING_STRATEGY=structural
# SEMANTIC_CHUNK_PERCENTILE=85

# Small-to-big retrieval: search precise chunks, then hand synthesis the whole section each
# winner came from. Section bodies are always recorded, so enabling this needs no re-index.
# PARENT_CONTEXT=false

# Cross-encoder reranking of fused documents. RRF ranks by retriever consensus and never
# compares a document against the question; a cross-encoder does. Needs an optional extra:
#   uv sync --extra rerank-cohere    (RERANKER=cohere, needs COHERE_API_KEY)
#   uv sync --extra rerank-local     (RERANKER=cross_encoder, pulls in torch)
# RERANKER=none
# COHERE_API_KEY=
# RERANK_TOP_N=12

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Richer key definitions than API_KEYS can express -- scopes, expiry, per-key rate limits:
#   {"keys": [{"key": "sk-...", "owner": "alice", "scopes": ["read", "write"],
#              "expires_at": "2026-12-31T23:59:59Z", "rate_limit_rpm": 120}]}
# Editing the file revokes or rotates a key on the next request, without a restart.
# API_KEYS_FILE=

# ---------------------------------------------------------------------------
# Scaling (all optional; defaults need no infrastructure)
# ---------------------------------------------------------------------------
# One switch that sets the shared backends coherently. "single-node" (the default) changes
# nothing: embedded Chroma, SQLite conversations, in-process ingest tasks, no infrastructure.
# "multi-replica" turns on pgvector + Postgres conversations + Redis tasks together and
# requires DATABASE_URL, because half-shared combinations fail as flakiness rather than as
# misconfiguration. Individual switches below still win where set explicitly.
# DEPLOYMENT_PROFILE=single-node

# Ingest task state across replicas. "memory" is per-process and correct for one worker.
# TASK_BACKEND=memory
# How many times an ingest may be attempted before it is failed for good, and how long to
# wait between in-process retries. A file that crashes the parser crashes it again, so the
# ceiling is what stops one bad upload becoming a restart loop.
# INGEST_MAX_ATTEMPTS=3
# INGEST_RETRY_DELAY_SECONDS=2
# How long an ingest may sit in a non-terminal stage before a restart concludes it was
# orphaned and fails it. Must exceed the longest legitimate gap between stage updates on a
# large corpus, or a slow ingest gets failed out from under itself.
# INGEST_STALE_AFTER_SECONDS=900
# How often a replica re-checks whether *another* replica ingested and its in-memory keyword
# index is stale. Only consulted with VECTOR_BACKEND=pgvector.
# BM25_VERSION_POLL_SECONDS=5
# Conversations and feedback in Postgres instead of SQLite -- SQLite's single-writer lock is
# the main thing preventing a second replica. Needs `uv sync --extra postgres`.
# CONVERSATIONS_BACKEND=sqlite
# DATABASE_URL=
# Where the vector index lives. "chroma" is embedded and file-locked to one process;
# "pgvector" puts it in Postgres instead, which removes that lock without running a second
# service when Postgres is already present for conversations. Needs `uv sync --extra
# postgres`, DATABASE_URL above, and the `vector` extension available in that database.
# The embedding column sizes itself on the first write -- there is no dimension to configure.
# VECTOR_BACKEND=chroma
# Share the vector index via a Chroma server rather than an embedded, file-locked one.
# CHROMA_SERVER_HOST=
# CHROMA_SERVER_PORT=8000
# CHROMA_SERVER_SSL=false

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------
# Per-tenant LLM token allowance per UTC day; 0 (the default) disables it. Rate limiting
# bounds how *often* a tenant asks and says nothing about what an ask costs -- a decomposed,
# multi-path, corrective run can cost orders of magnitude more than a routed-to-`none` one.
# Checked before a run and charged after, so a tenant may overshoot by at most one request.
# Shared across replicas only when Redis is reachable; logs loudly when it is not.
# TENANT_DAILY_TOKEN_BUDGET=0
# What one vision call counts as against that budget. Image cost scales with resolution and
# is not reported back, so this is a deliberate over-estimate: a cap that under-counts lets a
# tenant exceed the budget it exists to enforce.
# VISION_CALL_TOKEN_ESTIMATE=1500

# ---------------------------------------------------------------------------
# Retrieval quality
# ---------------------------------------------------------------------------
# Shingle containment at or above which fusion treats two retrieved passages as the same one.
# Exact hashing collapsed only byte-identical text, so a local copy and a web copy of one page
# both reached synthesis and earned separate citation markers for the same words. Measured,
# true near-duplicates score 1.000 and the nearest false positive 0.333 (see fusion/rrf.py).
# 0 disables similarity matching and leaves only exact and normalized hashing.
# FUSION_NEAR_DUPLICATE_THRESHOLD=0.9

# ---------------------------------------------------------------------------
# Capacity
# ---------------------------------------------------------------------------
# Worker threads for synchronous handlers. `POST /api/v1/research` is a sync handler holding
# one thread for a whole multi-second graph run, which makes this the real concurrency
# ceiling of a worker: at 40, the 41st concurrent research request queues rather than starts,
# however idle the CPU is. Watch `rag_research_in_flight` against this number.
# API_THREADPOOL_SIZE=40

# ---------------------------------------------------------------------------
# Distributed tracing (optional; needs `uv sync --extra otel`)
# ---------------------------------------------------------------------------
# OTLP endpoint for spans, e.g. http://localhost:4318/v1/traces. Blank leaves tracing off and
# imports nothing. The per-request trace_id already correlates logs; this adds the
# parent/child structure that shows where a slow request actually spent its time.
# OTEL_EXPORTER_OTLP_ENDPOINT=
