{
  "title": "Adaptive RAG Research Assistant",
  "uid": "rag-assistant",
  "tags": [
    "rag",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "description": "Route labels are Starlette path templates, so ids never mint new series.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(rag_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(rag_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(rag_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_http_requests_total{status=\"4xx\"}[5m])) / clamp_min(sum(rate(rag_http_requests_total[5m])), 0.001)",
          "legendFormat": "4xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Research latency percentiles",
      "type": "timeseries",
      "description": "GRAPH_TIMEOUT_SECONDS defaults to 45s -- p95 approaching it means requests are about to be cut off.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_http_request_duration_seconds_bucket{route=\"/api/v1/research\"}[10m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_http_request_duration_seconds_bucket{route=\"/api/v1/research\"}[10m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_http_request_duration_seconds_bucket{route=\"/api/v1/research\"}[10m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Graph outcomes",
      "type": "timeseries",
      "description": "ok / error / timeout are separated because the response to each differs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(rag_graph_runs_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Per-node latency (p95)",
      "type": "timeseries",
      "description": "Which stage of the pipeline is slow -- routing, retrieval, grading or synthesis.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(rag_graph_node_duration_seconds_bucket[10m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM calls by provider and outcome",
      "type": "timeseries",
      "description": "The fallback chain is otherwise silent: a primary-provider outage shows up only here.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(rag_llm_calls_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Token burn rate (per hour)",
      "type": "timeseries",
      "description": "The metric that maps onto money.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (model, kind) (rate(rag_llm_tokens_total[1h])) * 3600",
          "legendFormat": "{{model}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cache hit rate",
      "type": "timeseries",
      "description": "Dashboard-only, never paged: a cache outage is slower and costlier, never wrong.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(rag_cache_operations_total{result=\"hit\"}[10m])) / clamp_min(sum(rate(rag_cache_operations_total{result=~\"hit|miss\"}[10m])), 0.001)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Open SSE streams",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rag_sse_streams_active",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Ingestion outcomes",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (stage) (increase(rag_ingest_tasks_total[1h]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Answer feedback",
      "type": "timeseries",
      "description": "The only signal here sourced from users rather than from the system itself.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (rating) (increase(rag_feedback_total[24h]))",
          "legendFormat": "{{rating}}",
          "refId": "A"
        }
      ]
    }
  ]
}
