__pycache__/
*.pyc
.venv/
chroma_db/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
config.bat
node_modules
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# Secrets -- never commit; use .env.example as the template
.env
frontend/.env

# Local data stores
# Ingested documents. The five baseline files are tracked; anything else in here arrived
# through an upload (or a stray test run) and is local data, not source.
data/corpus/*
!data/corpus/anthropic.md
!data/corpus/google_deepmind.md
!data/corpus/meta_ai.md
!data/corpus/mistral_ai.md
!data/corpus/openai.md
# Tenant-uploaded documents (see ingestion/ownership.py) -- private data, never committed
data/corpus/_t/

# Backup archives written by `rag-assistant backup`. Local recovery state containing
# conversation history and corpus contents -- never source, and never committed.
backups/

# Directories `restore` moves aside instead of deleting (see backup.py). Local recovery
# state, never source.
*.pre-restore-*

# OS / shell artifacts
.DS_Store
nul
.coverage
coverage.xml
htmlcov/
